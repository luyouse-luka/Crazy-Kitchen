{
  "//": "仅供仓库根的 vitest 与 pnpm typecheck 使用。Cocos 用的是 game/tsconfig.json，两者互不干扰。",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["vitest/globals"]
  },
  "//include": "scripts/ 里只收 a7-check.ts —— 同目录的 Cocos 组件 import 'cc'，这里没有引擎类型声明",
  "include": [
    "game/assets/logic/**/*.ts",
    "game/assets/scripts/a7-check.ts",
    "tests/**/*.ts",
    "pipeline/**/*.ts",
    "tools/**/*.ts",
    "vitest.config.ts"
  ]
}
